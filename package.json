{
  "name": "dawra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dawra / دورة — Arabic-first field-service management SaaS for GCC maintenance contractors",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "db:reset": "node server/db/reset.js",
    "smoke:web": "node scripts/smoke-render.mjs",
    "test": "node --test --test-concurrency=1 \"server/tests/*.test.mjs\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "postcss": "^8.5.29",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21",
    "zod": "^4.6.5"
  }
}
