# Required
DATABASE_URL=postgres://dawra:dawra@localhost:5432/dawra
JWT_SECRET=change-me-to-a-long-random-string   # production refuses to boot if missing or < 16 chars
# Optional
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000   # used to build tracking/booking/payment links
SEED_DEMO=false                           # true → seed demo company on boot
DISABLE_SCHEDULER=false
PGSSL=false                               # true for managed PG that needs SSL without sslmode in URL
# AI (B5) — absent → deterministic keyword triage
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# WhatsApp Cloud API (B5) — absent → messages logged as 'simulated'
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Moyasar (B2) — absent → simulated payment links
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
